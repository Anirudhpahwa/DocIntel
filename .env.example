# ---- PostgreSQL (used by docker-compose.yml) ----
POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel
POSTGRES_DB=docintel
# Host port Postgres is published on. Defaults to 5433 to avoid clashing with
# a system-wide Postgres or another project already using 5432.
POSTGRES_PORT=5433

# ---- Backend (backend/.env) ----
# Full SQLAlchemy connection string the FastAPI backend uses to reach Postgres.
# Port must match POSTGRES_PORT above.
DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5433/docintel

# Locally running Ollama runtime.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Local filesystem root for uploaded documents. Optional — defaults to
# <repo_root>/storage if unset.
# STORAGE_ROOT=

# Reject uploads larger than this (megabytes).
MAX_UPLOAD_SIZE_MB=100

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8002
